# Base URL of the PhishGuard FastAPI backend.
#
# The value is an ORIGIN (scheme + host), never a path prefix: every request in
# src/api/client.ts already starts with "/api/". Setting this to "/api" would
# produce "/api/api/analyze".

# Development (default): the Vite dev server does not proxy /api (see
# vite.config.ts), so point the frontend straight at the backend. Leave the line
# commented out to use the built-in default (http://localhost:8000).
# VITE_API_BASE_URL=http://localhost:8000

# Production, same origin (recommended): leave it EMPTY so the browser requests
# relative /api/... URLs and the reverse proxy serves both the frontend build
# and the API. This is the shape deploy/ documents.
# VITE_API_BASE_URL=

# Production, separate API origin: use the full origin, with no path.
# VITE_API_BASE_URL=https://api.example.com
