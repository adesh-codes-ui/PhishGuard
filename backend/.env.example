# Copy this file to ".env" and adjust values for your machine.
# NEVER commit the real .env file. It is already listed in .gitignore.

# Where the SQLite database file lives (relative paths resolve against backend/).
# For production, set this to an absolute path on persistent storage.
PHISHGUARD_DATABASE_PATH=phisguard.db

# Comma-separated list of origins allowed to call this API.
# For development: http://localhost:5173,http://127.0.0.1:5173
# For production:  https://phisguard.example.com  (wildcards are not allowed
# when PHISHGUARD_ENVIRONMENT=production; do not trust X-Forwarded-For unless a
# proxy explicitly implements that contract.)
PHISHGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level (critical, error, warning, info, debug). If unset, the server uses
# its uvicorn/append-only log configuration; PhishGuard also applies it to its
# own "phishguard" logger.
PHISHGUARD_LOG_LEVEL=info

# --- Deployment / environment (Day 11) ------------------------------------ #
# App mode: "development" (default) or "production". In production:
# - interactive API docs (/docs, /redoc, /openapi.json) are disabled by default
# - wildcards (*) are not allowed in PHISHGUARD_CORS_ORIGINS
# - startup logs include non-secret configuration and any deployment warnings
PHISHGUARD_ENVIRONMENT=development

# Interactive API docs. Leave unset (auto) to follow the environment default.
# Set to "true" to force-enable in production; set to "false" to force-disable
# in development.
# PHISHGUARD_DOCS_ENABLED=false

# Maximum number of history rows returned by GET /api/history?limit= (1..1000).
# Default 100 (matches the documented API contract).
PHISHGUARD_HISTORY_LIMIT=100

# --- API hardening (Day 10) ----------------------------------------------- #
# Largest accepted request body in bytes (rejected with HTTP 413 before the
# JSON is parsed). Default 16384 (16 KiB); a URL is capped at 2048 characters.
PHISHGUARD_MAX_REQUEST_BODY_BYTES=16384

# Optional in-memory rate limiting. DISABLED by default: the counter lives in
# one process, so "uvicorn --workers N" gives each worker its own allowance.
# Treat it as best-effort abuse mitigation, not a security boundary, and put a
# shared limiter (reverse proxy / API gateway) in front for real protection.
# Health probes and CORS preflights are never limited.
PHISHGUARD_RATE_LIMIT_ENABLED=false
PHISHGUARD_RATE_LIMIT_REQUESTS=60
PHISHGUARD_RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional VirusTotal threat intelligence ------------------------------ #
# Leave VIRUSTOTAL_API_KEY unset to keep PhishGuard fully offline (heuristics
# only). When set, PhishGuard may look up an *existing* VirusTotal report for a
# URL. It never submits your URLs for scanning.
#
# The key is read ONLY from this variable name (no PHISHGUARD_ prefix), is
# never sent to the frontend, and must never be committed.
# VIRUSTOTAL_API_KEY=your-virustotal-api-key

# Toggle external lookups without removing the key (default: true).
PHISHGUARD_VIRUSTOTAL_ENABLED=true

# Per-request timeout in seconds for the external lookup (default: 10).
PHISHGUARD_VIRUSTOTAL_TIMEOUT_SECONDS=10

# Override the API base URL (default: the official API v3 endpoint).
PHISHGUARD_VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# --- Production notes (recommended) ---------------------------------------- #
# - Terminate TLS at a reverse proxy (do not rely on uvicorn's --ssl-* alone
#   unless you are on a controlled, internal-only path).
# - Enforce a proxy-level body-size cap equal to or smaller than
#   PHISHGUARD_MAX_REQUEST_BODY_BYTES, plus a shared rate limit; the in-process
#   limiter protects one worker only.
# - Do not trust X-Forwarded-For for rate-limiting decisions unless the proxy
#   is explicitly configured and IPs are sanitized; uvicorn must be run with
#   --proxy-headers and --forwarded-allow-ips pointing only at the trusted
#   proxy.
# - Set PHISHGUARD_ENVIRONMENT=production and explicit PHISHGUARD_CORS_ORIGINS.
#   /docs, /redoc, /openapi.json are disabled by default in production.
# - Keep the database path on a persistent, backed-up volume; ensure the
#   backend process can read and write it.
