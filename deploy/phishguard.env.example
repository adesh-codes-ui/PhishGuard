# PhishGuard production environment file.
#
# EXAMPLE / TEMPLATE. Placeholders are marked <...>. Used by
# deploy/phisguard.service through EnvironmentFile=.
#
# Install (never commit this file):
#   sudo install -o root -g phisguard -m 640 deploy/phishguard.env.example \
#       /etc/phisguard/phishguard.env
#
# Every PHISHGUARD_* key below is a real setting in backend/app/config.py (a
# test in backend/tests/test_deploy_artifacts.py fails if the two drift apart),
# and every value here is safe to read: the only secret PhishGuard uses is
# VIRUSTOTAL_API_KEY, which is left unset.

# Production mode: disables /docs, /redoc and /openapi.json by default, rejects
# a wildcard CORS origin at startup, and logs deployment warnings.
PHISHGUARD_ENVIRONMENT=production

# Absolute path on the persistent volume created by StateDirectory=phisguard.
# THIS is the file to back up; see backend/ops/README.md.
PHISHGUARD_DATABASE_PATH=/var/lib/phisguard/phisguard.db

# The public origin of THIS frontend, and nothing else. Wildcards are rejected
# in production. Add additional explicit origins comma-separated if needed.
PHISHGUARD_CORS_ORIGINS=https://phisguard.example.com

PHISHGUARD_LOG_LEVEL=info

# Interactive API docs stay disabled in production. Do NOT set this to true on a
# host that is reachable from the public internet.
# PHISHGUARD_DOCS_ENABLED=false

PHISHGUARD_HISTORY_LIMIT=100
PHISHGUARD_MAX_REQUEST_BODY_BYTES=16384

# The in-process limiter counts per process and is off by default. The effective
# SHARED limit belongs at the reverse proxy: the nginx example provides it
# (deploy/nginx-phisguard.conf.example -> limit_req). The Caddy example does NOT
# -- Caddy has no built-in limiter and its example block is commented out until
# you build Caddy with the third-party caddy-ratelimit module. Do not assume a
# limit is in place just because this setting is false.
# Leave this off unless you deliberately want a second, per-process cap.
PHISHGUARD_RATE_LIMIT_ENABLED=false

# Optional external enrichment. Left OFF so a default deployment is fully
# offline. To enable lookup-only enrichment, set this to true AND provide
# VIRUSTOTAL_API_KEY (read from its own variable name, no PHISHGUARD_ prefix).
# PhishGuard only reads an existing VirusTotal report; it never submits a URL.
PHISHGUARD_VIRUSTOTAL_ENABLED=false
PHISHGUARD_VIRUSTOTAL_TIMEOUT_SECONDS=10

# --- Reminder: this API has NO authentication ------------------------------- #
# GET /api/history returns every URL analyzed on this instance to anyone who can
# reach it. Keep the service on a private network / VPN, or require
# authentication at the reverse proxy. See deploy/README.md ("History access").
